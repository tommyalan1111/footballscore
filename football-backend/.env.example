# Get your key at https://dashboard.api-football.com
API_SPORTS_KEY=your_key_here

PORT=3000

# --- Daily quota (free plan: 100 requests/day, resets at 00:00 UTC) ---------
# The server spreads this budget over the rest of the day instead of using
# fixed timers, so it can never run dry halfway through.
DAILY_BUDGET=100

# Requests held back so a new date lookup still works while the poller is busy.
BUDGET_RESERVE=12

# Fastest the poller may poll. Only reached when DAILY_BUDGET is large
# (e.g. 7500/day gives ~12s -> capped here at 60s).
LIVE_POLL_MS=60000

# Slowest the poller goes while no match is live (protects the budget).
IDLE_POLL_MS=1800000

# Hard stop when api-sports says this few requests are left.
MIN_QUOTA_REMAINING=5

# --- Fixture cache ----------------------------------------------------------
# Live scores are overlaid from the poller, so these can be long.
DATE_TTL_TODAY_MS=900000
DATE_TTL_PAST_MS=86400000
DATE_TTL_FUTURE_MS=3600000
